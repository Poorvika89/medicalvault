{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Base profile for all users",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "fullName": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "medicalDegree": { "type": "string" },
        "qualification": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "preferredLanguage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "fullName"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A prescription, lab report, or medical document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report", "document"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "recordDate": { "type": "string", "format": "date" },
        "ocrData": { "type": "object" }
      },
      "required": ["patientId", "type", "title", "fileUrl", "createdAt"]
    },
    "AccessRequest": {
      "title": "Access Request",
      "description": "Doctor's request for patient data access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "granted", "revoked", "expired"] },
        "requestedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "status", "requestedAt"]
    },
    "AccessLog": {
      "title": "Access Log",
      "description": "Record of who viewed what and when",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "recordId": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "recordId", "viewedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Patient medical records"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific notifications"
    },
    "/accessRequests/{requestId}": {
      "schema": "AccessRequest",
      "description": "Requests from doctors to patients"
    },
    "/users/{userId}/accessLogs/{logId}": {
      "schema": "AccessLog",
      "description": "Logs of data access for a patient"
    }
  }
}
